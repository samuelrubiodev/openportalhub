# Waitlist API configuration template.
#
# Copy to .env on the server and fill in the real values; the .env file is
# git-ignored and must never be committed. Every variable below is read by
# server/env.ts, which refuses to start with one clear message listing anything
# missing or malformed.
#
# The template itself is named env.example (no leading dot) so it can live in
# the repository: the harness safety policy, and the .env.* ignore rule, both
# cover env dotfiles.

# OCI Email Delivery public endpoint for the sending region (console:
# Email Delivery → Configuration; format smtp.email.<region>.oci.oraclecloud.com).
SMTP_HOST=smtp.email.<region>.oci.oraclecloud.com
# 465 implicit TLS (recommended by Oracle); 587 STARTTLS; 25 plain.
SMTP_PORT=465
# true = implicit TLS on connect (port 465); false = STARTTLS/plain (587, 25).
SMTP_SECURE=true
# Oracle-generated SMTP credential username (console: Identity → Users → SMTP
# credentials). SMTP_USER and SMTP_PASSWORD are set together, or both omitted
# for an unauthenticated relay (local development).
SMTP_USER=ocid1.user.oc1..exampleusername@example.oraclecloud.com
# Oracle-generated SMTP credential password (shown once, at creation time).
SMTP_PASSWORD=example-smtp-password

# Approved sender in the sending region (console: Email Delivery → Approved
# Senders). Oracle rejects any other From: address. Bare address only: the
# From: display name is per brand and comes from the brand profile.
MAIL_FROM=beta@openportalhub.org
# Address that receives replies by default, and the one shown on the
# withdrawal pages.
MAIL_REPLY_TO=legal@openportalhub.org
# Mailbox that receives withdrawal notices until the panel exists.
NOTIFY_EMAIL=legal@openportalhub.org

# No SITE_URL here: the public origin is per brand (each brand profile in the
# waitlist package carries its own siteUrl, used to build the message links).
# HMAC key for the withdrawal links: openssl rand -hex 32. Rotating it revokes
# every link already sent, which is the intended revocation path until storage
# exists. Minimum 32 characters.
TOKEN_SECRET=replace-with-openssl-rand-hex-32
# Optional postal address printed in the legal block of the confirmation mail.
# Leave empty to omit the line; a postal address is advisable for commercial
# mail and none has been provided yet.
LEGAL_POSTAL_ADDRESS=

# smtp in production; json prints the serialized message instead of sending it.
MAIL_TRANSPORT=smtp
# Sends allowed per client IP per hour. In-memory and per process: a restart or
# a second replica resets it.
RATE_LIMIT_PER_IP_PER_HOUR=5
# Minutes before the same address may receive a second confirmation.
RATE_LIMIT_PER_EMAIL_MINUTES=15
